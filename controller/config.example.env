# Copy to ~/.config/homelab/controller.env (chmod 600); never commit the real file.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_FILE=
GITHUB_INSTALLATION_ID=
# Comma-separated owner/repo allowlist, at most five.
GITHUB_REPOSITORIES=dom-schulz/homelab
PROXMOX_API_URL=https://<pve>:8006
PROXMOX_API_TOKEN=gha-controller@pve!controller=<secret>
PROXMOX_NODE=pve
# Proxmox's default certificate is self-signed; only set this on the private network.
PROXMOX_TLS_INSECURE=true
PROXMOX_RUNNER_POOL=gha-runners
PROXMOX_RUNNER_TEMPLATE_VMID=910
# Runner VMs only ever use IDs in this range.
PROXMOX_RUNNER_VMID_RANGE=9200-9209
# Refuse to clone while this many VMs are already in the pool.
PROXMOX_MAX_POOL_VMS=2
RUNNER_LABEL=homelab-ephemeral
MAX_CONCURRENT_RUNNERS=1
POLL_INTERVAL_SECONDS=20
