#cloud-config
hostname: ${hostname}
manage_etc_hosts: true
package_update: true
package_upgrade: true
packages:
  - ca-certificates
  - curl
  - git
  - jq
  - qemu-guest-agent
  - tar
  - unzip
users:
  - default
  - name: ${admin_username}
    gecos: Runner template administrator
    groups: [adm, sudo]
    shell: /bin/bash
    lock_passwd: true
    sudo: ["ALL=(ALL) NOPASSWD:ALL"]
    ssh_authorized_keys:
      - '${ssh_public_key}'
write_files:
  - path: /usr/local/sbin/prepare-runner-template
    owner: root:root
    permissions: '0750'
    encoding: b64
    content: ${base64encode(<<-SCRIPT
      #!/usr/bin/env bash
      set -Eeuo pipefail
      test "$(id -u)" -eq 0 || { echo 'Run as root.' >&2; exit 1; }
      systemctl stop actions.runner.* 2>/dev/null || true
      rm -rf /opt/actions-runner/_work /opt/actions-runner/.credentials* /opt/actions-runner/.runner 2>/dev/null || true
      docker system prune --all --force 2>/dev/null || true
      rm -f /etc/machine-id
      touch /etc/machine-id
      cloud-init clean --logs --seed
      journalctl --rotate || true
      journalctl --vacuum-time=1s || true
      history -c || true
      sync
      echo 'Template cleaned. Shut down this VM and convert it to a Proxmox template.'
    SCRIPT
    )}
runcmd:
  - [bash, -c, "install -m 0755 -d /etc/apt/keyrings && curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc && chmod a+r /etc/apt/keyrings/docker.asc && . /etc/os-release && printf 'deb [arch=%s signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu %s stable\\n' \\"$(dpkg --print-architecture)\\" \\"$VERSION_CODENAME\\" > /etc/apt/sources.list.d/docker.list && apt-get update && apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin && systemctl enable docker qemu-guest-agent"]
  - [bash, -c, "usermod -aG docker ${admin_username} && install -d -o ${admin_username} -g ${admin_username} /opt/actions-runner"]
